{
  "name": "ego-skills",
  "version": "0.3.0",
  "private": true,
  "description": "Community Agent Skills for ego-browser. Skills: pinterest-download, instagram-saved-download. Not published to npm.",
  "license": "MIT",
  "keywords": [
    "ego-browser",
    "ego-lite",
    "agent-skills",
    "codex",
    "claude",
    "cursor",
    "browser-automation"
  ],
  "scripts": {
    "test": "c8 node --test skills/pinterest-download/scripts/test/*.test.mjs skills/instagram-saved-download/scripts/test/*.test.mjs",
    "install-skills": "bash ./scripts/install-skills.sh"
  },
  "c8": {
    "include": [
      "skills/pinterest-download/scripts/lib/pure.mjs",
      "skills/pinterest-download/scripts/lib/run.mjs",
      "skills/pinterest-download/scripts/lib/launch.mjs",
      "skills/pinterest-download/scripts/lib/media-fetch.mjs",
      "skills/instagram-saved-download/scripts/lib/pure.mjs",
      "skills/instagram-saved-download/scripts/lib/run.mjs",
      "skills/instagram-saved-download/scripts/lib/launch.mjs",
      "skills/instagram-saved-download/scripts/lib/media-fetch.mjs"
    ],
    "exclude": [
      "skills/*/scripts/test/**"
    ],
    "reporter": [
      "text",
      "json-summary"
    ],
    "reports-dir": "coverage",
    "check-coverage": true,
    "lines": 80
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
