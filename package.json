{
  "name": "ego-skills",
  "version": "0.6.0",
  "private": true,
  "description": "Community Agent Skills for ego-browser. Skills: pinterest-download, instagram-saved-download, wechat-channels-video, kuaishou-video, youtube-video, douyin-video. Not published to npm.",
  "license": "MIT",
  "keywords": [
    "ego-browser",
    "ego-lite",
    "agent-skills",
    "codex",
    "claude",
    "cursor",
    "browser-automation",
    "kuaishou",
    "youtube",
    "douyin"
  ],
  "scripts": {
    "test": "c8 node --test skills/*/scripts/test/*.test.mjs scripts/test/*.test.mjs",
    "new-skill": "node scripts/new-skill.mjs",
    "install-skills": "bash ./scripts/install-skills.sh"
  },
  "c8": {
    "all": true,
    "include": [
      "skills/*/scripts/lib/**/*.mjs"
    ],
    "exclude": [
      "skills/*/scripts/test/**",
      "skills/*/scripts/lib/ego-deps.mjs"
    ],
    "reporter": [
      "text",
      "json-summary"
    ],
    "reports-dir": "coverage",
    "check-coverage": true,
    "lines": 80
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
